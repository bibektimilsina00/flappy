# Behind Cloudflare (orange cloud, SSL mode Full-strict). Caddy serves the
# Cloudflare Origin certificate (valid ~15y, no ACME/renewal) and reverse-proxies.
riocut.com {
	tls /etc/caddy/certs/origin.pem /etc/caddy/certs/origin.key
	encode zstd gzip

	# API + WebSockets. lb_try_duration makes Caddy retry the dial for up to 15s
	# when the upstream is briefly down (container restart) → no 502 during deploys.
	handle /api/* {
		reverse_proxy api:8000 {
			lb_try_duration 15s
			lb_try_interval 500ms
		}
	}

	handle {
		reverse_proxy web:3000 {
			lb_try_duration 15s
			lb_try_interval 500ms
		}
	}
}

www.riocut.com {
	tls /etc/caddy/certs/origin.pem /etc/caddy/certs/origin.key
	redir https://riocut.com{uri} permanent
}
