# Caddy gets/renews Let's Encrypt certs automatically for these hosts.
riocut.com {
	encode zstd gzip

	# API + WebSockets
	handle /api/* {
		reverse_proxy api:8000
	}

	# MinIO presigned URLs (path-style: /<bucket>/<key>?sig)
	handle /video-assets/* {
		reverse_proxy minio:9000
	}

	handle {
		reverse_proxy web:3000
	}
}

www.riocut.com {
	redir https://riocut.com{uri} permanent
}
