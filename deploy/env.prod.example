# Production env — copy to /opt/riocut/.env on the VPS and fill in.
# Read by docker-compose.prod.yml (postgres/minio creds) and by api/worker/beat.

# ── Compose-level secrets ─────────────────────────────
POSTGRES_PASSWORD=change-me-long-random

# ── Core ──────────────────────────────────────────────
# No ${VAR} interpolation in env files — repeat the postgres password here.
DATABASE_URL=postgresql+psycopg://postgres:change-me-long-random@postgres:5432/video
REDIS_URL=redis://redis:6379/0
SECRET_KEY=change-me-long-random
ACCESS_TOKEN_EXPIRE_MINUTES=43200

# ── Storage (MinIO) ───────────────────────────────────
# Cloudflare R2 (S3-compatible). Presigned URLs serve from R2 directly.
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=riocut-media
S3_ACCESS_KEY=riocut
S3_SECRET_KEY=change-me-long-random

# ── URLs ──────────────────────────────────────────────
API_BASE_URL=https://riocut.com
FRONTEND_URL=https://riocut.com

# ── OAuth (leave blank to disable a provider) ─────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# ── Generation provider keys ──────────────────────────
GEMINI_API_KEY=
OPENAI_API_KEY=
OPEN_ROUTER_API_KEY=
REPLICATE_API_KEY=
NOVITA_API_KEY=
# Editor stock search (Pexels). Blank = stock search disabled.
PEXELS_API_KEY=
# Editor "Eye Contact" gaze-correction Replicate model ("owner/name"). Blank = off.
EYE_CONTACT_MODEL=
# Editor "Face Filter" face-touchup Replicate model ("owner/name"). Blank = off.
FACE_FILTER_MODEL=
# Editor "AI Background Expand" outpainting Replicate model ("owner/name"). Blank = off.
BACKGROUND_EXPAND_MODEL=
# Editor "AI Transition" morph model ("owner/name"); image_1/image_2 (+prompt) -> video. Blank = off.
TRANSITION_MORPH_MODEL=
# Editor "Talking Characters" model ("owner/name"); image + text -> talking-head video. Blank = off.
TALKING_CHARACTER_MODEL=

# ── Spend guardrail (USD/day, 0 = off) ────────────────
DAILY_SPEND_CAP_USD=0

# ── yt-dlp cookies (YouTube bot-walls datacenter IPs) ─
# Netscape cookies.txt placed at /opt/riocut/ytdlp/cookies.txt on the VPS.
CLIPS_COOKIES_FILE=/ytdlp/cookies.txt
# Residential proxy for link ingestion (empty = direct). ~$1/GB pay-as-you-go.
CLIPS_PROXY=

# ── Social publishing OAuth apps ──────────────────────
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
X_CLIENT_ID=
X_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
CLIPS_POT_PROVIDER_URL=http://pot:4416
# Model that judges which moments become clips — the quality knob of the
# product. Empty = catalog default (a free model; noticeably worse picks).
CLIPS_SELECT_MODEL=google/gemini-3.6-flash

# Dodo Payments (fill after creating product + webhook in dashboard)
DODO_API_KEY=
DODO_WEBHOOK_KEY=
DODO_ENVIRONMENT=test_mode
DODO_PRODUCT_PLUS=
DODO_PRODUCT_PRO=
DODO_PRODUCT_ULTRA=
DODO_PRODUCT_STUDIO_S=
DODO_PRODUCT_STUDIO_M=
DODO_PRODUCT_STUDIO_L=
DODO_PRODUCT_STUDIO_XL=
DODO_PRODUCT_STUDIO_MAX=
