# Copy to .env and fill in. Read by the API/worker from the repo root.

# ── Core ──────────────────────────────────────────────
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/video
REDIS_URL=redis://localhost:6379/0
SECRET_KEY=change-me
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── Storage (MinIO / S3) ──────────────────────────────
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=video-assets
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio123

# ── URLs ──────────────────────────────────────────────
API_BASE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

# ── OAuth (leave blank to disable a provider) ─────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# ── Generation provider keys ──────────────────────────
GEMINI_API_KEY=
NOVITA_API_KEY=
# Editor stock search (Pexels). Blank = stock search disabled.
PEXELS_API_KEY=
# Background removal (Replicate matting). Blank = feature disabled.
REPLICATE_API_KEY=
# Editor "Eye Contact" gaze-correction Replicate model ("owner/name"). Blank = off.
EYE_CONTACT_MODEL=
# Editor "Face Filter" face-touchup Replicate model ("owner/name"). Blank = off.
FACE_FILTER_MODEL=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
X_CLIENT_ID=
X_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
